# Variables para ejecución local DIRECTA del backend (sin Docker):
# copiar a un archivo llamado .env dentro de backend/ y ajustar valores.
# No commitear el .env real.

PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=team_notes
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=1h

# SAM Local en el propio host.
LAMBDA_METRICS_URL=http://127.0.0.1:3001/metrics

# Orígenes CORS extra (opcional, lista separada por comas).
# Vacío = valores locales por defecto (5500, 8080...).
CORS_ORIGINS=
