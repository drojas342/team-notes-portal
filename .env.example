# Variables para Docker Compose (entorno Docker).
# Copiar a un archivo llamado .env en ESTA misma carpeta y ajustar valores.
# No commitear el .env real. No son los mismos valores que backend/.env.example
# (ese sigue usándose para ejecución local directa sin Docker).

# MySQL (servicio "mysql")
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=team_notes
MYSQL_USER=teamnotes
MYSQL_PASSWORD=change_this_password

# Backend (dentro de Docker; DB_HOST=mysql se fija en docker-compose.yml)
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=1h

# SAM Local corre en el HOST (sam local start-api --port 3001).
# Desde el contenedor backend se alcanza vía host.docker.internal.
LAMBDA_METRICS_URL=http://host.docker.internal:3001/metrics

# Orígenes CORS extra (opcional). Vacío = valores locales por defecto.
# Para AWS, añadir aquí el dominio CloudFront, p. ej.:
# CORS_ORIGINS=https://d123abc.cloudfront.net
CORS_ORIGINS=
